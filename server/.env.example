# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/qr_menu

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Client URLs — every app lives under one host, on its own path
# (local: dev gateway on :8080 via `npm run dev`; production: your reverse proxy)
CLIENT_ADMIN_URL=http://localhost:8080/admin
CLIENT_MENU_URL=http://localhost:8080/menu
CLIENT_KITCHEN_URL=http://localhost:8080/kitchen
CLIENT_SUPER_ADMIN_URL=http://localhost:8080/super-admin

# QR Code base URL — host only; QR codes encode <QR_BASE_URL>/menu/<restaurantId>/<tableId>
# Use your LAN IP (e.g. http://192.168.1.20:8080) to scan QR codes from a phone on the same Wi-Fi
QR_BASE_URL=http://localhost:8080

# Super admin access — comma-separated Google account emails
SUPER_ADMIN_EMAILS=founder@example.com,cofounder@example.com

# Optional — encrypts staff PINs so the owner can view them on the Staff page (falls back to JWT_SECRET).
# Changing it makes saved PINs unviewable until reset; PIN login keeps working.
PIN_ENCRYPTION_KEY=
