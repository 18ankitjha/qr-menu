# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/qr_menu

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Client URLs
CLIENT_ADMIN_URL=http://localhost:5173
CLIENT_MENU_URL=http://localhost:5174
CLIENT_KITCHEN_URL=http://localhost:5175

# QR Code base URL (used to encode in QR codes)
QR_BASE_URL=http://localhost:5174
