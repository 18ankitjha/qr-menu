## DM Layer Pattern

Each DM file follows this pattern — it's the **single source of truth** for all business logic and data access for that entity:

```typescript
// dm/restaurant/restaurant.dm.ts

import { RestaurantModel } from './restaurant.model';
import { IRestaurant, IRegisterRestaurantInput } from '../../interfaces/restaurant.interface';

// Every DM function is a named export
export const registerRestaurant = async (input: IRegisterRestaurantInput): Promise<IRestaurant> => {
  // 1. Business validation (e.g., check user doesn't already own a restaurant)
  // 2. Data transformation
  // 3. DB operation via Mongoose model
  // 4. Return result
};

export const getRestaurantById = async (id: string): Promise<IRestaurant | null> => {
  return RestaurantModel.findById(id).lean();
};

export const updateRestaurant = async (id: string, updates: Partial<IRestaurant>): Promise<IRestaurant | null> => {
  return RestaurantModel.findByIdAndUpdate(id, updates, { new: true }).lean();
};

// ... more DM functions
```

**Controller calls DM, never touches model directly:**
```typescript
// controllers/restaurant.controller.ts
import * as RestaurantDM from '../dm/restaurant/restaurant.dm';
import { sendSuccess, sendError } from '../utils/response.util';

export const registerRestaurant = async (req: Request, res: Response) => {
  try {
    const restaurant = await RestaurantDM.registerRestaurant(req.body);
    return sendSuccess(res, restaurant, 'Restaurant registered successfully', 201);
  } catch (error) {
    return sendError(res, error);
  }
};
```

